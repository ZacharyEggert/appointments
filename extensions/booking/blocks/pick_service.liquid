{%- render 'appt-widget', block: block, heading: block.settings.heading, services: block.settings.services -%}

{% schema %}
{
  "name": "Pick a Service",
  "target": "content",
  "javascript": "appt-widget.js",
  "stylesheet": "appt-widget.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book a time"
    },
    {
      "type": "text",
      "id": "services",
      "label": "Service handles",
      "info": "Leave blank for all published Services, or enter handles separated by commas. Find each handle at the end of its Service page URL."
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "default": "/apps/appointments",
      "info": "If you changed the app proxy URL in Shopify, enter its path here."
    },
    {
      "type": "header",
      "content": "Customer details"
    },
    {
      "type": "select",
      "id": "phone",
      "label": "Phone field",
      "options": [
        {
          "value": "hidden",
          "label": "Hidden"
        },
        {
          "value": "optional",
          "label": "Optional"
        },
        {
          "value": "required",
          "label": "Required"
        }
      ],
      "default": "optional"
    },
    {
      "type": "checkbox",
      "id": "show_notes",
      "label": "Show notes field",
      "default": true
    },
    {
      "type": "text",
      "id": "notes_label",
      "label": "Notes label",
      "default": "Notes",
      "info": "For example: Which guitar would you like to try?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Book button label",
      "default": "Book selected time"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color",
      "info": "Fills the selected time and the Book button. Leave empty to match your theme."
    },
    {
      "type": "color",
      "id": "accent_text",
      "label": "Text on accent color"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Spacing",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ]
}
{% endschema %}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model GoogleOAuthState {
  state     String   @id
  shop      String
  expiresAt DateTime

  @@index([shop])
}

model GoogleConnection {
  shop         String   @id
  refreshToken String
  accessToken  String
  expiresAt    DateTime
  scope        String
  status       String   @default("connected")
  connectedAt  DateTime @default(now())
}

model Resource {
  id           String @id @default(cuid())
  shop         String
  name         String
  calendarId   String
  timeZone     String
  openingHours Json   @default("[]")

  @@index([shop])
}

model ShopSettings {
  shop                 String @id
  durationMinutes      Int    @default(30)
  startIntervalMinutes Int    @default(15)
  bufferBeforeMinutes  Int    @default(0)
  bufferAfterMinutes   Int    @default(0)
  minNoticeMinutes     Int    @default(0)
  maxAdvanceDays       Int    @default(30)
}
